<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nexus.banking.client.controller.RoomsPaneController">
    <VBox minWidth="340" prefWidth="380" maxWidth="420" style="-fx-border-color: transparent #2D2D38 transparent transparent; -fx-border-width: 0 1 0 0;">
        <VBox styleClass="band" minHeight="68" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="20" bottom="10" left="24" /></padding>
            <Label text="Rooms" styleClass="title-md" />
            <Label fx:id="roomsHint" styleClass="text-muted" />
        </VBox>
        <ListView fx:id="roomList" VBox.vgrow="ALWAYS" />
        <HBox spacing="10" styleClass="band-top" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="20" bottom="12" left="24" /></padding>
            <Button fx:id="joinButton" text="Join room" styleClass="btn-primary" onAction="#onJoin" />
            <Button fx:id="leaveButton" text="Leave room" styleClass="btn-secondary" onAction="#onLeave" />
        </HBox>
    </VBox>
    <VBox HBox.hgrow="ALWAYS">
        <VBox styleClass="band" minHeight="68" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="24" bottom="10" left="24" /></padding>
            <Label fx:id="membersTitle" styleClass="title-md" />
            <Label fx:id="membersHint" styleClass="text-muted" />
        </VBox>
        <StackPane VBox.vgrow="ALWAYS">
            <ListView fx:id="memberList" />
            <VBox fx:id="membersEmpty" alignment="CENTER" spacing="8" managed="false" visible="false">
                <Label fx:id="membersEmptyTitle" styleClass="empty-title" />
                <Label fx:id="membersEmptyText" styleClass="text-muted" wrapText="true" maxWidth="360" />
            </VBox>
        </StackPane>
    </VBox>
</HBox>
