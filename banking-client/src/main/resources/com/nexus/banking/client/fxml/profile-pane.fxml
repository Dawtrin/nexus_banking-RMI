<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nexus.banking.client.controller.ProfilePaneController">
    <VBox styleClass="band" minHeight="68" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="24" bottom="10" left="24" /></padding>
        <Label text="Profile" styleClass="title-md" />
        <Label text="How other people see you in rooms" styleClass="text-muted" />
    </VBox>
    <HBox spacing="36" alignment="TOP_LEFT">
        <padding><Insets top="32" right="32" bottom="32" left="32" /></padding>
        <VBox spacing="10" alignment="TOP_CENTER" minWidth="140" prefWidth="140">
            <StackPane fx:id="avatarHolder" alignment="CENTER" minWidth="90" minHeight="90" />
            <Button fx:id="uploadAvatarBtn" text="Upload Image" styleClass="btn-secondary" onAction="#onUploadAvatar" maxWidth="Infinity" />
            <Button fx:id="resetAvatarBtn" text="Reset Avatar" styleClass="btn-ghost" onAction="#onResetAvatar" maxWidth="Infinity" />
            <Label text="GX PRESETS" styleClass="section-tag">
                <VBox.margin><Insets top="8" bottom="2" /></VBox.margin>
            </Label>
            <FlowPane fx:id="presetContainer" hgap="6" vgap="6" alignment="CENTER" prefWrapLength="130" />
        </VBox>
        <VBox spacing="14" maxWidth="460" HBox.hgrow="ALWAYS">
            <VBox spacing="6">
                <Label text="Username" styleClass="form-label" />
                <Label fx:id="usernameLabel" styleClass="text-mono" />
                <Label text="Your username identifies this sign-in and cannot be changed here." styleClass="text-faint" wrapText="true" />
            </VBox>
            <VBox spacing="6">
                <Label text="Display name" styleClass="form-label" />
                <TextField fx:id="nameField" />
            </VBox>
            <VBox spacing="6">
                <Label text="Email (optional)" styleClass="form-label" />
                <TextField fx:id="emailField" promptText="name@example.com" />
                <Label text="Only stored on this server for you; never shown to other users." styleClass="text-faint" wrapText="true" />
            </VBox>
            <VBox spacing="6">
                <Label text="Status" styleClass="form-label" />
                <ComboBox fx:id="presenceCombo" prefWidth="200" />
            </VBox>
            <HBox fx:id="errorBanner" styleClass="banner-error" managed="false" visible="false"><Label fx:id="errorLabel" wrapText="true" /></HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="saveButton" text="Save changes" styleClass="btn-primary" onAction="#onSave" />
                <Label fx:id="resultLabel" styleClass="text-faint" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
