<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nexus.banking.client.controller.SettingsPaneController">
    <VBox styleClass="band" minHeight="68" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="24" bottom="10" left="24" /></padding>
        <Label text="Settings" styleClass="title-md" />
        <Label text="Stored on this computer only" styleClass="text-muted" />
    </VBox>
    <HBox VBox.vgrow="ALWAYS">
        <VBox fx:id="sections" spacing="4" styleClass="section-menu" minWidth="200" prefWidth="210" maxWidth="220">
            <padding><Insets top="20" right="12" bottom="20" left="16" /></padding>
        </VBox>
        <StackPane HBox.hgrow="ALWAYS" alignment="TOP_LEFT">
            <padding><Insets top="28" right="36" bottom="28" left="36" /></padding>
            <VBox fx:id="connectionSection" spacing="14" maxWidth="460">
                <Label text="Server connection" styleClass="title-md" />
                <Label text="Used the next time you sign in. Changing it does not move the session you are in." styleClass="text-muted" wrapText="true" />
                <VBox spacing="6"><Label text="Server address" styleClass="form-label" /><TextField fx:id="hostField" /></VBox>
                <VBox spacing="6" maxWidth="140"><Label text="Port" styleClass="form-label" /><TextField fx:id="portField" /></VBox>
                <CheckBox fx:id="autoReconnect" text="Reconnect automatically when the connection drops" />
                <HBox spacing="12" alignment="CENTER_LEFT"><Button text="Save changes" styleClass="btn-primary" onAction="#onSave" /><Label fx:id="savedLabel" styleClass="text-faint" /></HBox>
                <HBox fx:id="errorBanner" styleClass="banner-error" managed="false" visible="false"><Label fx:id="errorLabel" wrapText="true" /></HBox>
            </VBox>
            <VBox fx:id="appearanceSection" spacing="14" maxWidth="460" managed="false" visible="false">
                <Label text="Appearance" styleClass="title-md" />
                <Label text="NEXUS GX uses its dark void cyberpunk theme. You can adjust the text scaling." styleClass="text-muted" wrapText="true" />
                <VBox spacing="6" maxWidth="220"><Label text="Text size" styleClass="form-label" /><ComboBox fx:id="fontCombo" maxWidth="Infinity" /></VBox>
            </VBox>
            <VBox fx:id="notificationSection" spacing="14" maxWidth="460" managed="false" visible="false">
                <Label text="Notifications" styleClass="title-md" />
                <Label text="Applied while the NEXUS window is not in front." styleClass="text-muted" wrapText="true" />
                <CheckBox fx:id="unreadTitle" text="Show the number of new messages in the window title" onAction="#onNotificationChanged" />
                <CheckBox fx:id="beep" text="Play a beep for a new message from someone else" onAction="#onNotificationChanged" />
            </VBox>
            <VBox fx:id="securitySection" spacing="14" maxWidth="520" managed="false" visible="false">
                <Label text="Security" styleClass="title-md" />
                <Label text="What protects you today" styleClass="form-label" />
                <Label text="Sign-in uses a username only. It is a name tag, not proof of who you are." styleClass="text-muted" wrapText="true" />
                <Label text="The connection can be protected with end-to-end TLS/SSL encryption or run on an intranet/VPN." styleClass="text-muted" wrapText="true" />
                <Button text="Forget saved server and username" styleClass="btn-secondary" onAction="#onForget" />
                <Label fx:id="forgetLabel" styleClass="text-faint" />
            </VBox>
        </StackPane>
    </HBox>
</VBox>
