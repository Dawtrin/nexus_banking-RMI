<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nexus.banking.control.ui.LoginController" styleClass="app-shell">
    <StackPane fx:id="hero" styleClass="login-hero" HBox.hgrow="ALWAYS" minWidth="340" />
    <VBox styleClass="login-form" alignment="CENTER_LEFT" spacing="12" minWidth="470" prefWidth="480" maxWidth="480">
        <padding><Insets top="28" right="46" bottom="28" left="46" /></padding>
        <Label text="Đăng nhập Trung tâm điều hành" styleClass="title-lg" />
        <Label text="Giám sát và điều hành cả hai chi nhánh. Cần admin token đã cấu hình trên các máy chủ." styleClass="text-muted" wrapText="true" />
        <VBox spacing="6"><Label text="Tên điều hành viên" styleClass="form-label" /><TextField fx:id="operatorField" promptText="Được ghi vào sổ kiểm toán" /></VBox>
        <VBox spacing="6"><Label text="Admin token" styleClass="form-label" /><PasswordField fx:id="tokenField" promptText="NEXUS_ADMIN_TOKEN của máy chủ" onAction="#onConnect" /></VBox>
        <HBox spacing="10">
            <VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Chi nhánh A - Hà Nội (host:port)" styleClass="form-label" /><TextField fx:id="nodeAField" /></VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS"><Label text="Chi nhánh B - TP.HCM (host:port)" styleClass="form-label" /><TextField fx:id="nodeBField" /></VBox>
        </HBox>
        <CheckBox fx:id="sslCheck" text="Mã hóa TLS / SSL (khuyến nghị)" />
        <HBox fx:id="errorBanner" styleClass="banner-error" managed="false" visible="false"><Label fx:id="errorLabel" wrapText="true" /></HBox>
        <Button fx:id="connectButton" text="Kết nối" styleClass="btn-primary" maxWidth="Infinity" defaultButton="true" onAction="#onConnect" />
        <Label fx:id="statusLabel" styleClass="text-faint" wrapText="true" />
        <Label fx:id="securityNoticeLabel" text="Token chỉ giữ trong bộ nhớ, không lưu ra đĩa." styleClass="text-faint" wrapText="true" />
    </VBox>
</HBox>
